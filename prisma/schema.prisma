// Automatic offers — typed conditions.
model AutoOfferRule {
  id              String   @id @default(cuid())
  name            String
  condition       String   // "REFERRALS_AT_LEAST" | "FIRST_BOOKING" | "BIRTHDAY_MONTH"
  conditionValue  Int?
  rewardType      String   // "PERCENT" | "FIXED" | "FREE"
  rewardValue     Int
  active          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

