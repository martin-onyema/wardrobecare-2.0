// ============================================================
// PERSONAL SHOPPING — paid sourcing service
// (Distinct from the free ServiceEnquiry path.)
// Statuses: NEW → SOURCING → SENT → APPROVED → PAID → FULFILLING → DONE
// ============================================================

enum PersonalShoppingStatus {
  NEW          // sourcing fee paid, to accept
  SOURCING     // stylist accepted, building shortlist
  SENT         // shortlist sent to customer
  APPROVED     // customer choices recorded
  PAID         // items paid, ready to dispatch/fit
  FULFILLING   // out for delivery or at fitting
  DONE         // delivered / fitting complete
  CANCELLED
}

enum PSReviewMethod {
  ONLINE      // customer gets a link to a shortlist page
  WHATSAPP    // stylist sends list via WhatsApp
  ONSITE      // items prepared for in-person fitting
}

enum PSItemType {
  SHIRTS
  TROUSERS
  SUITING
  FOOTWEAR
  ACCESSORIES
  FRAGRANCE
  TRADITIONAL
}

enum PSItemDecision {
  PENDING
  KEEP
  SKIP
  WANTS_DIFFERENT
}

model PersonalShoppingRequest {
  id              String   @id @default(cuid())
  ref             String   @unique // e.g. WC-PS-1051
  userId          String?  // who booked and paid

  // ─── Customer ───
  customerName    String
  customerPhone   String
  contactVia      String   // "Call" | "WhatsApp" | "Email"
  shoppingFor     String   // "Self" or "Femi (Husband)"

  // ─── Service type ───
  tier            String   // "DELIVERED" | "IN_PERSON_FITTING"
  reviewMethod    PSReviewMethod @default(ONLINE)
  area            String?  // delivery area (Lagos zone or outside Lagos)
  isLagos         Boolean  @default(true)

  // ─── Brief ───
  brief           String
  categories      String   // comma-sep
  colours         String   // comma-sep
  budget          String
  neededBy        String?

  // ─── Brand guard (Mockup 50) ───
  brandMentioned   String?  // comma-sep brand terms detected in brief
  brandAcknowledged String? // customer saw PS vs Premium Sourcing explanation

  // ─── Stylist ───
  stylistId       String?
  stylist         User?    @relation("PersonalShoppingStylist", fields: [stylistId], references: [id], onDelete: SetNull)

  // ─── Fee ───
  sourcingFeePaid Int      @default(45000)
  discountLabel   String?
  discountAmount  Int      @default(0)
  paymentReference String? @unique
  paidAt          DateTime?

  // ─── Fitting (only for IN_PERSON_FITTING) ───
  fittingDate     DateTime?
  fittingTime     String?
  fittingArea     String?
  fittingElapsedMinutes Int @default(0)

  // ─── Fulfilment ───
  deliveryFeeQuoted Int?   // for outside-Lagos delivery
  deliveryFeeZone   Int?  // for Lagos delivery (from zone table)
  riderName          String?
  paymentMethod     String? // "link" | "cod" | "paid"

  // ─── Workflow ───
  status          PersonalShoppingStatus @default(NEW)

  // ─── Relations ───
  user            User?    @relation("PersonalShoppingUser", fields: [userId], references: [id], onDelete: SetNull)
  items           PSItem[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([stylistId])
  @@index([userId])
}

model PSItem {
  id              String   @id @default(cuid())
  requestId       String
  request         PersonalShoppingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  name            String
  category        PSItemType
  size            String
  price           Int      // naira
  source          String   // "In stock" | "Sourced from supplier"
  stylistNote     String?
  decision        PSItemDecision @default(PENDING)
  decisionNote    String?  // for WANTS_DIFFERENT: what they want instead
  createdAt       DateTime @default(now())

  @@index([requestId])
}

// Single-row PS fee settings (like ConsultationServiceSetting)
model PSServiceSetting {
  id                    String   @id @default("singleton")
  deliveredFee          Int      @default(45000)
  inPersonFittingFee    Int      @default(50000)
  includedMinutes       Int      @default(60)
  extraBlockMinutes     Int      @default(30)
  extraBlockFee         Int      @default(5000)
  updatedAt             DateTime @updatedAt
}

// Delivery fees by Lagos zone (same data as Delivery Charges page)
model PSDeliveryZone {
  id        String  @id @default(cuid())
  zone      String  @unique
  fee       Int
  createdAt DateTime @default(now())
}

// PS promo codes (discount sourcing fee only, never items)
model PSPromoCode {
  id           String    @id @default(cuid())
  code         String    @unique
  type         String    // "PERCENT" | "FIXED" | "FREE"
  value        Int
  service      String    @default("Both") // "Personal Shopping" | "Both"
  expiresAt    DateTime?
  timesUsed    Int       @default(0)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([active])
}

// PS audit events (like BookingEvent for consultations)
model PSEvent {
  id          String   @id @default(cuid())
  requestId   String
  actorId     String?
  actorType   String   // "CUSTOMER" | "STAFF" | "SYSTEM"
  note        String?
  createdAt   DateTime @default(now())

  @@index([requestId, createdAt])
}

// ============================================================
// PERSONAL SHOPPING — spec-aligned additions (Mockups 50, 52)
// ============================================================

// Structured brief (separate from the free-text `brief` column on the
// request). Captures the full style questionnaire from the booking wizard.
model PSBrief {
  id          String   @id @default(cuid())
  requestId   String   @unique
  fit         String?  // "Slim" | "Regular" | "Relaxed" | "Not sure"
  style       String?  // free-text style preferences
  occasion    String?  // "Work" | "Events" | "Everyday" | "Wedding" | ...
  budgetBand  String?  // "₦100,000 to ₦250,000" | "₦250,000 to ₦500,000" | ...
  sizes       String?  // comma-sep top/bottom/shoe sizes
  notes       String?  // additional notes from the brief
  createdAt   DateTime @default(now())
}

// Brief guard — stores whether the brief text triggered a brand/exact-item
// alert, and whether the customer acknowledged it before continuing.
// Computed server-side at booking time so staff see the Brand tag.
model PSBriefFlag {
  id              String   @id @default(cuid())
  requestId       String   @unique
  terms           String   // comma-sep detected terms: "Gucci, Nike"
  customerChoice  String   // "CONTINUED_ACK" | "WAITLIST"
  createdAt       DateTime @default(now())
}

// In-Person fitting slot (held for 10 min during checkout, like
// ConsultationBooking.holdUntil but for PS).
model PSSlot {
  id          String    @id @default(cuid())
  requestId   String   @unique
  date        DateTime
  start       String   // "9:00 AM", "11:30 AM", ...
  area        String?
  heldUntil   DateTime?
  createdAt   DateTime @default(now())
}

// Shortlist container — one per request, holds items + a shareable
// token for the online review page. 48-hour hold on items.
model PSShortlist {
  id          String    @id @default(cuid())
  requestId   String   @unique
  token       String   @unique @default(cuid()) // for the public review URL
  sentAt      DateTime?
  channel     String?  // "ONLINE" | "WHATSAPP" | "ONSITE"
  holdUntil   DateTime? // 48h from sentAt
  createdAt   DateTime @default(now())
}

// ShortlistItem — replaces PSItem. Each item belongs to a PSShortlist
// (which belongs to a request). Carries the customer's decision.
model PSShortlistItem {
  id              String   @id @default(cuid())
  shortlistId     String
  name            String
  category        PSItemType
  size            String
  price           Int
  source          String   // "IN_STOCK" | "SUPPLIER"
  stylistNote     String?
  decision        PSItemDecision @default(PENDING)
  altNote         String?  // for WANTS_DIFFERENT: what they want instead
  decidedBy       String?  // "CUSTOMER" | "STAFF"
  decidedAt       DateTime?
  createdAt       DateTime @default(now())

  @@index([shortlistId])
}

// Fulfilment record — captures delivery/fitting state in a structured
// form separate from the request's flat columns.
model PSFulfilment {
  id              String    @id @default(cuid())
  requestId       String   @unique
  deliveryFee     Int?     // area fee or quoted fee
  quoteBy         String?  // staff who quoted (for outside Lagos)
  payMode         String?  // "LINK" | "COD" | "ONSITE"
  rider           String?
  dispatchedAt    DateTime?
  deliveredAt     DateTime?
  fittingStart    DateTime?
  fittingEnd      DateTime?
  extraBlocks     Int      @default(0)
  exchangeUntil48 DateTime?
  exchangeUntil24 DateTime?
  createdAt       DateTime @default(now())
}

// ============================================================
// SMS LOG — every Termii send attempt (success or failure)
// ============================================================
// The previous SMS sender logged to console only, so missed SMS
// notifications were invisible to the store owner. This model
// records each attempt: who triggered it, what payload was sent,
// what Termii returned, and any error string. Surfaced in the
// admin Notifications area for self-diagnosis.
model SmsLog {
  id           String   @id @default(cuid())
  // What triggered the SMS (NEW_ORDER, PAYMENT_SUCCESS, MANUAL_TEST, etc.)
  reason       String
  // Optional link back to the order, if the SMS was order-related
  orderId      String?
  order        Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  // Recipient phone (normalised to international format, e.g. 2348012345678)
  recipient    String
  // The SMS body that was sent (truncated for storage)
  message      String
  // Send result
  ok           Boolean  @default(false)
  // Provider error code or short failure reason ("not-configured", "termii-401", etc.)
  error        String?
  // Raw provider response, if we got one (truncated)
  providerResponse String?
  // Resolved sender — env var name or "AdminSettings.supportPhone"
  // so admins can see how the phone was chosen
  recipientSource String? // "TERMII_TO" | "AdminSettings.supportPhone" | "AdminSettings.whatsappNumber" | "manual"
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([ok])
  @@index([reason])
  @@index([orderId])
}

// ============================================================
// SEO MANAGER — overrides for static pages/services, redirects, templates, audit log
// ============================================================

// SEO overrides for routes that don't have a dedicated DB model
// (services from services-data.ts, static pages like /about, /faq, etc.).
// Keyed by the public route, e.g. "/services/wardrobe-consultation", "/about".
model SeoOverride {
  id            String   @id @default(cuid())
  route         String   @unique // e.g. "/about", "/services/wardrobe-consultation"
  contentType   String   // "page" | "service"
  name          String   // for display in the admin list
  seoTitle      String?
  seoDescription String?
  h1            String?
  introText     String?
  ogImage       String?
  noindex       Boolean  @default(false)
  inSitemap     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([contentType])
  @@index([noindex])
  @@index([inSitemap])
}

// URL redirects — created automatically on slug change, or manually.
// The middleware looks up the request path here and issues a 308
// (permanent) or 307 (temporary) to the destination.
model Redirect {
  id          String   @id @default(cuid())
  fromPath    String   @unique // e.g. "/services/old-slug" — must start with /
  toPath      String   // e.g. "/services/new-slug" — must start with /
  statusCode  Int      @default(308) // 308 permanent, 307 temporary, 301 (legacy permanent)
  note        String?  // optional reason — "slug change", "manual", etc.
  createdById String?
  createdBy   User?    @relation("RedirectAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([fromPath])
  @@index([toPath])
}

// SEO templates per content type — used by the "Auto templates" tab to
// fill empty SEO fields with sensible defaults that include {name}/{name_lc} tokens.
model SeoTemplate {
  id                  String   @id @default(cuid())
  contentType         String   @unique // "category" | "product" | "service" | "page"
  titleTemplate       String?
  descriptionTemplate String?
  introTemplate       String?
  altTemplate         String?
  updatedAt           DateTime @updatedAt
}

// Audit log for SEO changes — who changed what, when, on which entity.
model SeoAuditLog {
  id          String   @id @default(cuid())
  entityType  String   // "category" | "product" | "service" | "page" | "redirect" | "template"
  entityId    String   // id or route
  fieldName   String   // "seoTitle", "slug", "noindex", etc.
  oldValue    String?
  newValue    String?
  changedById String?
  changedBy   User?    @relation("SeoAuditLogAuthor", fields: [changedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([changedById])
  @@index([createdAt])
}
