// Gap list item — what to buy next.
model GapItem {
  id          String   @id @default(cuid())
  bookingId   String
  booking     ConsultationBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  name        String
  priority    String   // "High" | "Medium" | "Low"
  createdAt   DateTime @default(now())

  @@index([bookingId])
}

// Published consultation summary (Mockup 43).
model ConsultationSummary {
  id              String   @id @default(cuid())
  bookingId       String   @unique
  booking         ConsultationBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  styleDirection  String?
  palette         String?
  silhouette      String?
  publishedAt     DateTime @default(now())
}

// Price snapshot — one per booking.
model BookingPrice {
  id              String   @id @default(cuid())
  bookingId       String   @unique
  booking         ConsultationBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  listPrice       Int
  discountType    String?  // "PERCENT" | "FIXED" | "FREE" | "CUSTOM"
  discountValue   Int?
  discountSource  String?  // "CODE" | "AUTO" | "STAFF"
  discountLabel   String?
  discountAmount  Int      @default(0)
  appliesToAll    Boolean  @default(false)
  amountDue       Int
  amountPaid      Int
  staffReason     String?
  staffNote       String?
  appliedBy       String?
  appliedAt       DateTime?
}

// One row per promo code redemption. One use per customer.
model PromoRedemption {
  id          String   @id @default(cuid())
  codeId      String
  code        ConsultationPromoCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  accountId   String
  bookingId   String   @unique
  booking     ConsultationBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amountOff   Int
  redeemedAt  DateTime @default(now())

