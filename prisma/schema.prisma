// ============================================================
// CONSULTATION BOOKINGS — paid-at-booking sessions
// (Wardrobe & Style Consultation, etc.)
//
// Spec: wardrobecare consultation backend workflow. Booking states:
//   HELD (10 min, before payment)
//     -> PAID                    payment success webhook
//     -> EXPIRED                 hold timer ran out, slot released
//   PAID
//     -> CONFIRMED               staff confirm (needs stylist assigned, no clash)
//     -> NEEDS_NEW_DATE          staff: "date not available" + 2-3 new slots offered
//   NEEDS_NEW_DATE
//     -> CONFIRMED               customer picks one offered slot
//     (stays NEEDS_NEW_DATE until resolved; reminder at 6h/24h; alert staff at 48h)
//   CONFIRMED
//     -> NEEDS_NEW_DATE          staff can still move it later
//     -> IN_SESSION              stylist starts session
//     -> NO_SHOW / CANCELLED
//   IN_SESSION -> COMPLETED      stylist finishes (audit, outfits, gaps required)
//   COMPLETED  -> SUMMARY_SENT   send Wardrobe Map + Gap List + publish summary
//
// Every transition writes a row to BookingEvent (who, when, from, to, note).
// ============================================================

enum ConsultationBookingStatus {
  HELD              // slot held for 10 min, awaiting payment
  EXPIRED           // hold timer ran out, slot released
  PAID              // payment success webhook
  NEEDS_NEW_DATE    // staff: date not available + 2-3 new slots offered
  CONFIRMED         // staff confirmed (needs stylist assigned, no clash)
  IN_SESSION        // stylist started the session
  COMPLETED         // session finished (audit, outfits, gaps required)
  SUMMARY_SENT      // summary sent + Wardrobe Map + Gap List published
  NO_SHOW           // customer didn\'t show up
  CANCELLED         // cancelled (refund handled separately)
}

model ConsultationBooking {
  id              String   @id @default(cuid())
  bookingNumber   String   @unique
  userId          String?  // accountId — who booked and paid
  profileId       String?  // who the session is for (managed profile, or null=self)

  // ─── Booker / contact details ───
  bookerName      String
  bookerPhone     String
  contactMethod   String   // "Call" | "WhatsApp" | "Email"

  // ─── Recipient details ───
  recipientName   String
  recipientRelation String?

  // ─── Session details ───
  sessionMode     String   // "In-person" | "Video call"
  location        String?  // area in Lagos, only if In-person
  slotDate        DateTime // the booked date (UTC midnight)
  slotTime        String   // "9:00 AM", "11:30 AM", "2:00 PM", "4:30 PM"

  // ─── Style goals ───
  promptWhy       String?
  occasions       String?
  frustration     String?

  // ─── Stylist assignment ───
  assignedStylistId String?
  assignedStylist   User?  @relation("ConsultationBookingStylist", fields: [assignedStylistId], references: [id], onDelete: SetNull)

  // ─── Payment ───
  listPrice       Int      @default(45000) // snapshot of fee at booking time
  amountPaid      Int      @default(45000) // naira actually paid (after discount)
  paymentReference String? @unique        // Paystack transaction reference
  paidAt          DateTime?

  // ─── Discount snapshot (denormalised from BookingPrice) ───
  discountLabel   String?
  discountAmount  Int      @default(0)
  discountAppliesToAll Boolean @default(false)
  discountPct     Int?
  discountFree    Boolean  @default(false)
  promoCodeId     String?

  // ─── Slot hold ───
  holdUntil       DateTime?

  // ─── Workflow ───
  status          ConsultationBookingStatus @default(HELD)

  // ─── Reschedule ───
  rescheduleReason String?  // STYLIST_UNAVAILABLE | CLASH | CLOSURE | LOCATION
  rescheduledAt   DateTime?
  originalSlotDate DateTime?
  originalSlotTime String?

  // ─── Session workspace ───
  sessionStartedAt DateTime?
  elapsedMinutes  Int      @default(0)
  sessionNotes    String?
  extraTimeBilledAt DateTime?
  extraTimeAmount Int      @default(0)

  // ─── After the session ───
  summarySentAt           DateTime?
  returnVisitBookingId    String?
  personalShoppingBriefAt DateTime?

  // ─── Relations ───
  user              User?  @relation("ConsultationBookingUser", fields: [userId], references: [id], onDelete: SetNull)
  events            BookingEvent[]
  rescheduleOffers  RescheduleOffer[]
  auditItems        AuditItem[]
  outfitPhotos      OutfitPhoto[]
  gapItems          GapItem[]
  summary           ConsultationSummary?
  price             BookingPrice?
  promoRedemption   PromoRedemption?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([slotDate, slotTime])
  @@index([userId])
  @@index([assignedStylistId])
}

// Audit trail. Every status transition writes a row.
model BookingEvent {
  id          String   @id @default(cuid())
  bookingId   String
  booking     ConsultationBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actorId     String?
  actorType   String   // "CUSTOMER" | "STAFF" | "SYSTEM"
  fromStatus  String?
  toStatus    String
  note        String?
  channel     String?  // "WhatsApp" | "Email" | "SMS" | null
  createdAt   DateTime @default(now())

  @@index([bookingId, createdAt])
}

// One row per offered slot during a reschedule.
model RescheduleOffer {
  id          String    @id @default(cuid())
  bookingId   String
  booking     ConsultationBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  slotDate    DateTime
  slotTime    String
  offeredBy   String?
  offeredAt   DateTime  @default(now())
  chosenAt    DateTime?
  expiresAt   DateTime?

  @@index([bookingId])
}

// Wardrobe audit — keep / alter / retire.
model AuditItem {
  id          String   @id @default(cuid())
  bookingId   String
  booking     ConsultationBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  name        String
  category    String
  action      String   // "Keep" | "Alter" | "Retire"
  note        String?
  createdAt   DateTime @default(now())

  @@index([bookingId])
}

// Outfit photo — numbered, with occasion.
model OutfitPhoto {
  id          String   @id @default(cuid())
  bookingId   String
  booking     ConsultationBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  number      Int
  occasion    String
  imageUrl    String?
  createdAt   DateTime @default(now())

  @@unique([bookingId, number])
  @@index([bookingId])
