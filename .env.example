# Wardrobecare — local development template.
# Copy this file to ".env" and adjust if needed.
# Production values should be configured in the Vercel dashboard. Do not commit production secrets.

DATABASE_URL="file:./db/custom.db"
NEXTAUTH_SECRET="replace-with-a-random-production-secret"
NEXTAUTH_URL="http://localhost:3000"
ADMIN_ACCESS_PATH="/wardrobe-hq-9xk2"

# Optional: transactional emails via Gmail SMTP (primary) or Resend (fallback)
# GMAIL_USER="Wardrobecare@gmail.com"
# GMAIL_APP_PASSWORD="16-char-app-password-from-google"

# Optional: SMS notifications via Termii (sends new-order alerts to store owner)
# Get your API key from https://termii.com — Settings → API Keys
# TERMII_API_KEY="TL_xxxxxxxxxxxxxxxxxxxxxxxx"
# TERMII_SENDER_ID="WARDROBECARE"   # 3–11 chars, alphanumeric
# TERMII_TO="2348012345678"         # store owner's phone (international format)

# Optional: Resend fallback (only used if Gmail is not configured)
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Wardrobecare <codes@wardrobecare.com.ng>"
