{
  "version": 1,
  "functions": {
    "/_middleware": {
      "runtime": "nodejs",
      "matchers": [
        {
          "regexp": "^(?:\\/(_next\\/data\\/[^/]{1,}))?(?:\\/((?!api|_next\\/static|_next\\/image|images|uploads|favicon.ico|robots.txt|sitemap.xml).*))(\\.json)?[\\/#\\?]?$",
          "originalSource": "/((?!api|_next/static|_next/image|images|uploads|favicon.ico|robots.txt|sitemap.xml).*)"
        }
      ]
    },
    "/api/chat": {},
    "/api/webhooks/paystack": {}
  }
}