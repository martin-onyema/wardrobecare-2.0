{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/account/layout,_N_T_/account/verify/layout,_N_T_/account/verify/page,_N_T_/account/verify"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/account/verify/__PAGE__",
    "/account/verify",
    "/account",
    "/_index",
    "/_head"
  ]
}